{
  "name": "realheart",
  "version": "0.3.7",
  "description": "给她一个能记账的心情层：心情必须有来处，改动必须有账，她自己能停能查",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "realheart": "bin/realheart.mjs"
  },
  "files": [
    "index.mjs",
    "lib/",
    "bin/",
    "setup.mjs",
    "cordis.patch.yml",
    "runtime/*.py",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "skills/",
    "!**/*.bak-*",
    "client"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "realheart",
    "persona",
    "memory",
    "state"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayasaikou/saya-dsh-realheart.git"
  },
  "homepage": "https://github.com/sayasaikou/saya-dsh-realheart#readme",
  "bugs": {
    "url": "https://github.com/sayasaikou/saya-dsh-realheart/issues"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./client": {
      "default": "./client/index.js"
    },
    "./package.json": "./package.json"
  }
}